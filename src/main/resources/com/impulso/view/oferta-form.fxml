<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.impulso.controller.OfertaFormController"
            fitToWidth="true" styleClass="page-scroll">
    <VBox styleClass="page" spacing="20">
        <HBox alignment="CENTER_LEFT">
            <VBox spacing="4">
                <Label fx:id="lblTitulo" styleClass="h1"/>
                <Label fx:id="lblSubtitulo" styleClass="muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Volver al listado" styleClass="btn-secondary" onAction="#cancelar"/>
        </HBox>

        <HBox spacing="20">
            <VBox styleClass="card" spacing="16" HBox.hgrow="ALWAYS">
                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Título de la oferta *" styleClass="field-label"/>
                        <TextField fx:id="txtTitulo" promptText="Ej. Desarrollador Java"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Empresa *" styleClass="field-label"/>
                        <ComboBox fx:id="cmbEmpresa" promptText="Selecciona una empresa" maxWidth="Infinity"/>
                    </VBox>
                </HBox>
                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Estado *" styleClass="field-label"/>
                        <ComboBox fx:id="cmbEstado" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Fecha de postulación *" styleClass="field-label"/>
                        <DatePicker fx:id="dpFecha" promptText="DD/MM/AAAA" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Salario anual · €" styleClass="field-label"/>
                        <TextField fx:id="txtSalario" promptText="Opcional · bruto/año"/>
                    </VBox>
                </HBox>
                <VBox spacing="6">
                    <Label text="Enlace a la oferta" styleClass="field-label"/>
                    <TextField fx:id="txtEnlace" promptText="https:// · opcional"/>
                    <Label text="Introduce una URL válida que empiece por https:// o http://." styleClass="muted-small"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Descripción" styleClass="field-label"/>
                    <TextArea fx:id="txtDescripcion" prefRowCount="4" wrapText="true"
                              promptText="Responsabilidades, requisitos y condiciones de la oferta…"/>
                </VBox>
                <VBox spacing="6">
                    <Label fx:id="lblNotas" text="Notas iniciales" styleClass="field-label"/>
                    <TextArea fx:id="txtNotas" prefRowCount="3" wrapText="true"
                              promptText="Añade información útil para el seguimiento (opcional)."/>
                </VBox>
                <Label fx:id="lblError" styleClass="error-text" wrapText="true" managed="false" visible="false"/>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="form-foot">
                    <Label text="* Campos obligatorios" styleClass="muted-small"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Cancelar" styleClass="btn-secondary" onAction="#cancelar"/>
                    <Button text="✓  Guardar candidatura" styleClass="btn-primary" onAction="#guardar"/>
                </HBox>
            </VBox>

            <VBox spacing="20" minWidth="300" prefWidth="300" maxWidth="300">
                <VBox styleClass="card" spacing="10">
                    <Label text="Una oportunidad, una ficha" styleClass="h3"/>
                    <Label text="Centraliza la oferta y actualiza su estado a medida que avance el proceso."
                           wrapText="true" styleClass="body"/>
                    <Label text="¿No aparece la empresa? Créala primero desde la sección Empresas."
                           wrapText="true" styleClass="muted"/>
                </VBox>
                <VBox styleClass="card" spacing="8">
                    <Label text="Validación de datos" styleClass="h3"/>
                    <Label text="• Título: entre 3 y 120 caracteres." styleClass="muted-small"/>
                    <Label text="• Empresa: selecciona una registrada." styleClass="muted-small"/>
                    <Label text="• Fecha: no posterior a hoy." styleClass="muted-small"/>
                    <Label text="• Salario: importe anual igual o mayor que 0." styleClass="muted-small"/>
                    <Label text="• Los campos opcionales pueden quedar vacíos." styleClass="muted-small"/>
                    <Label text="Datos guardados en la base de datos." styleClass="muted-small"/>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
