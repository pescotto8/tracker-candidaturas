<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.impulso.controller.EmpresaFormController"
            fitToWidth="true" styleClass="page-scroll">
    <VBox styleClass="page" spacing="20">
        <HBox alignment="CENTER_LEFT">
            <VBox spacing="4">
                <Label fx:id="lblTitulo" styleClass="h1"/>
                <Label fx:id="lblSubtitulo" styleClass="muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Volver a empresas" styleClass="btn-secondary" onAction="#cancelar"/>
        </HBox>

        <HBox spacing="20">
            <VBox styleClass="card" spacing="14" HBox.hgrow="ALWAYS">
                <Label text="Datos de la empresa" styleClass="h3"/>
                <VBox spacing="6">
                    <Label text="Nombre *" styleClass="field-label"/>
                    <TextField fx:id="txtNombre" promptText="Ej. Indra"/>
                    <Label text="Usa el nombre con el que identificas a la empresa. Entre 2 y 100 caracteres."
                           styleClass="muted-small"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Sector *" styleClass="field-label"/>
                    <TextField fx:id="txtSector" promptText="Ej. Tecnología y consultoría"/>
                    <Label text="Describe su actividad principal." styleClass="muted-small"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Web" styleClass="field-label"/>
                    <TextField fx:id="txtWeb" promptText="https://www.empresa.com · opcional"/>
                    <Label text="URL válida con https:// o http://. Puedes dejarla vacía." styleClass="muted-small"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Fecha de registro *" styleClass="field-label"/>
                    <DatePicker fx:id="dpFecha" promptText="DD/MM/AAAA" maxWidth="Infinity"/>
                    <Label text="Formato DD/MM/AAAA. No puede ser posterior a hoy." styleClass="muted-small"/>
                </VBox>
                <Label fx:id="lblError" styleClass="error-text" wrapText="true" managed="false" visible="false"/>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="form-foot">
                    <Label text="* Campos obligatorios" styleClass="muted-small"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Cancelar" styleClass="btn-secondary" onAction="#cancelar"/>
                    <Button fx:id="btnGuardar" text="✓  Guardar empresa" styleClass="btn-primary" onAction="#guardar"/>
                </HBox>
            </VBox>

            <VBox spacing="20" minWidth="320" prefWidth="320" maxWidth="320">
                <VBox styleClass="card" spacing="10">
                    <Label fx:id="lblPanelTitulo" styleClass="h3"/>
                    <Label fx:id="lblPanelTexto" wrapText="true" styleClass="body"/>
                    <Label fx:id="lblPanelAviso" wrapText="true" styleClass="muted"/>
                </VBox>
                <VBox fx:id="cardCandidaturas" styleClass="card" spacing="8" managed="false" visible="false">
                    <Label text="Candidaturas asociadas" styleClass="h3"/>
                    <Label fx:id="lblCandResumen" styleClass="muted-small"/>
                    <VBox fx:id="listaCandidaturas" spacing="10"/>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
