<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.impulso.controller.EntrevistaFormController"
            fitToWidth="true" styleClass="page-scroll">
    <VBox styleClass="page" spacing="20">
        <HBox alignment="CENTER_LEFT">
            <VBox spacing="4">
                <Label fx:id="lblTitulo" styleClass="h1"/>
                <Label fx:id="lblSubtitulo" styleClass="muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Volver al detalle" styleClass="btn-secondary" onAction="#cancelar"/>
        </HBox>

        <HBox spacing="20">
            <VBox styleClass="card" spacing="14" HBox.hgrow="ALWAYS">
                <Label text="Datos de la entrevista" styleClass="h3"/>
                <Label fx:id="lblContexto" styleClass="context-chip" maxWidth="Infinity"/>
                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Fecha de entrevista *" styleClass="field-label"/>
                        <DatePicker fx:id="dpFecha" promptText="DD/MM/AAAA" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Hora" styleClass="field-label"/>
                        <TextField fx:id="txtHora" promptText="HH:mm · opcional"/>
                    </VBox>
                </HBox>
                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Tipo de entrevista *" styleClass="field-label"/>
                        <ComboBox fx:id="cmbTipo" promptText="Selecciona un tipo" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Resultado *" styleClass="field-label"/>
                        <ComboBox fx:id="cmbResultado" maxWidth="Infinity"/>
                    </VBox>
                </HBox>
                <VBox spacing="6">
                    <Label text="Notas" styleClass="field-label"/>
                    <TextArea fx:id="txtNotas" prefRowCount="6" wrapText="true"
                              promptText="Temas a preparar, persona de contacto o impresiones de la entrevista…"/>
                </VBox>
                <Label fx:id="lblError" styleClass="error-text" wrapText="true" managed="false" visible="false"/>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="form-foot">
                    <Label text="* Campos obligatorios" styleClass="muted-small"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Cancelar" styleClass="btn-secondary" onAction="#cancelar"/>
                    <Button text="✓  Guardar entrevista" styleClass="btn-primary" onAction="#guardar"/>
                </HBox>
            </VBox>

            <VBox styleClass="card" spacing="10" minWidth="320" prefWidth="320" maxWidth="320" alignment="TOP_LEFT">
                <Label text="Candidatura asociada" styleClass="h3"/>
                <Label fx:id="lblOfertaEstado" styleClass="pill"/>
                <Label fx:id="lblOfertaTitulo" styleClass="h2" wrapText="true"/>
                <Label fx:id="lblOfertaEmpresa" styleClass="muted"/>
                <Label fx:id="lblOfertaMeta" styleClass="body" wrapText="true"/>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
