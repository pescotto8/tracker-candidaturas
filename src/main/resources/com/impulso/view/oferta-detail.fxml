<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.impulso.controller.OfertaDetailController"
            fitToWidth="true" styleClass="page-scroll">
    <VBox styleClass="page" spacing="20">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="4">
                <Label fx:id="lblTitulo" styleClass="h1"/>
                <Label fx:id="lblSubtitulo" styleClass="muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Volver al listado" styleClass="btn-secondary" onAction="#volver"/>
            <Button text="✎  Editar" styleClass="btn-secondary" onAction="#editar"/>
            <Button text="Eliminar" styleClass="btn-danger" onAction="#eliminar"/>
        </HBox>

        <HBox styleClass="card" spacing="40" alignment="CENTER_LEFT">
            <VBox spacing="6">
                <Label text="Estado de la candidatura" styleClass="field-label"/>
                <ComboBox fx:id="cmbEstado" styleClass="estado-combo"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Fecha de postulación" styleClass="field-label"/>
                <Label fx:id="lblFecha" styleClass="strong"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Salario bruto anual" styleClass="field-label"/>
                <Label fx:id="lblSalario" styleClass="strong"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Enlace a la oferta" styleClass="field-label"/>
                <Hyperlink fx:id="linkOferta" onAction="#abrirOferta"/>
            </VBox>
        </HBox>

        <GridPane hgap="20" vgap="20">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="68"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="32"/>
            </columnConstraints>

            <VBox styleClass="card" spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Descripción de la oferta" styleClass="h3"/>
                <Label fx:id="lblDescripcion" wrapText="true" styleClass="body"/>
            </VBox>

            <VBox styleClass="card" spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="Empresa asociada" styleClass="h3"/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label fx:id="lblEmpIniciales" styleClass="company-badge"/>
                    <VBox>
                        <Label fx:id="lblEmpNombre" styleClass="strong"/>
                        <Label fx:id="lblEmpSector" styleClass="muted"/>
                    </VBox>
                </HBox>
                <Hyperlink fx:id="linkEmpWeb" onAction="#abrirEmpresaWeb"/>
                <Label fx:id="lblEmpMeta" styleClass="muted-small"/>
            </VBox>

            <VBox styleClass="card" spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="lblEntrevistasTitulo" styleClass="h3"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="+  Añadir entrevista" styleClass="btn-secondary" onAction="#nuevaEntrevista"/>
                </HBox>
                <TableView fx:id="tablaEntrevistas" fixedCellSize="40" prefHeight="140" minHeight="120">
                    <columns>
                        <TableColumn fx:id="colEFecha" text="Fecha y hora" prefWidth="170" sortable="false"/>
                        <TableColumn fx:id="colETipo" text="Tipo" prefWidth="130" sortable="false"/>
                        <TableColumn fx:id="colEResultado" text="Resultado" prefWidth="130" sortable="false"/>
                        <TableColumn fx:id="colEAcciones" text="Acciones" prefWidth="130" sortable="false"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                </TableView>
            </VBox>

            <VBox styleClass="card" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label text="Notas" styleClass="h3"/>
                <Label fx:id="lblNotas" wrapText="true" styleClass="body"/>
            </VBox>
        </GridPane>
    </VBox>
</ScrollPane>
